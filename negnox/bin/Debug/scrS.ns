






#képernyő streamelő script:
cmdme cd dataFromClients & del *.png & cd ..
wait 500
cmdme cd scrS & start "" scrS.exe & cd ..
say "képernyő felvevése kezdődik..."
wait 1200
output false

start-for 200
scr donotopen
wait 50
end-for

output true
cd %exetpath%
cd ..
cd data
cmd del *.png

wait 2000
say "lefutott a screenstream"








#képernyő streamelő script:
cmdme cd dataFromClients & del *.png & cd ..
wait 500
cmdme tasklist /FI "IMAGENAME eq scrS.exe" | findstr /I "scrS.exe" >nul || cd scrS & start "" scrS.exe & cd ..
say "képernyő felvevése kezdődik..."
wait 1200
output false

start-for 200
scr donotopen
wait 50
end-for

output true
wait 200
cd %exetpath%
wait 200
pwd
wait 200
cd %exetpath%
wait 200
cd ..
cd data
cmd del *.png

wait 2000
say "lefutott a screenstream"

#cmdme taskkill /IM "Microsoft.Photos.exe" /F


